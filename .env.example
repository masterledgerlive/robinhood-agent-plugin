# Copy to .env locally. Never commit real tokens.

# paper (default) logs and previews only. live sends real orders.
ROBINHOOD_TRADING_MODE=paper

# Optional. Cursor OAuth is preferred over pasting tokens.
# ROBINHOOD_MCP_ACCESS_TOKEN=

# Risk rails
ROBINHOOD_DAILY_DRAWDOWN_HALT_PCT=0.20
ROBINHOOD_MAX_BET_USD=2
ROBINHOOD_MAX_ROLL_USD=7

# Override only for mocks / tests.
# ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
